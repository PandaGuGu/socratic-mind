<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.socraticmind</groupId>
  <artifactId>psych-assistant</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>psych-assistant</name>
  <description>心理知识科普与 CBT 自助系统（模块化单体）</description>

  <modules>
    <module>psych-common</module>
    <module>psych-infrastructure</module>
    <module>psych-knowledge</module>
    <module>psych-rag</module>
    <module>psych-agent</module>
    <module>psych-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.socraticmind</groupId>
        <artifactId>psych-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.socraticmind</groupId>
        <artifactId>psych-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.socraticmind</groupId>
        <artifactId>psych-knowledge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.socraticmind</groupId>
        <artifactId>psych-rag</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.socraticmind</groupId>
        <artifactId>psych-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
