# 一键起的全部变量。首次运行 scripts/stack.sh（或 stack.ps1）会自动复制成 .env 并填好密钥。
# .env 不入库；这里是模板，可以放心提交。

# ---- 端口 ----
APP_PORT=8099
POSTGRES_PORT=15432

# ---- 数据库 ----
POSTGRES_DB=psych
POSTGRES_USER=psych
POSTGRES_PASSWORD=

# ---- 密钥（必须自己生成，不要用示例值）----
# 会话令牌签名密钥，至少 16 字节；换掉它，旧设备令牌立即失效
PSYCH_USER_SECRET=
# 内部后台令牌，访问 /internal 时要它
PSYCH_INTERNAL_TOKEN=
# 默认 false：页面不自动填令牌。只在本机、且信任同一台机器时改成 true
PSYCH_INTERNAL_DEV_HINT=false

# ---- 后台登录页的初始账号 ----
# dev-hint 关着时，登录页没有内置账号；这两行在首次启动时写入数据库（只写一次）。
# 留空口令 = 不播种，由 scripts/stack.* 首次运行时生成随机口令并回填到 .env。
PSYCH_OPERATOR_USER=admin
PSYCH_OPERATOR_PASSWORD=

TZ=Asia/Shanghai

# ---- 可选：接真实对话模型（OpenAI 兼容）----
# 容器档默认桩；要真实模型用 stack.sh up --ai（容器内 Ollama）。
# 接云端时把 SPRING_PROFILES_ACTIVE 改成 pg,http，并覆盖下面 5 个变量。
# SPRING_PROFILES_ACTIVE=pg,http
# PSYCH_AI_CHAT_PROVIDER=http
# PSYCH_AI_BASE_URL=https://api.deepseek.com
# PSYCH_AI_API_KEY=sk-...
# PSYCH_AI_CHAT_MODEL=deepseek-chat
# PSYCH_AI_TEMPERATURE=0.2
# PSYCH_AI_THINKING_DISABLED=false
# Qwen3 需要关闭思考；容器 --ai 档已代为打开
# PSYCH_AI_NO_THINK=true
# CPU 推理慢，读取超时给足
# PSYCH_AI_READ_TIMEOUT_SECONDS=180

# ---- 向量与迁移 ----
# 容器 --ai 档是 1024；默认桩是 256。改维度需要迁移，见 deploy/README。
# PSYCH_AI_EMBEDDING_DIMENSION=1024
# 显式允许启动时重建 embedding 列并重嵌入（默认 false，只报错不改数据）
# PSYCH_AI_VECTOR_MIGRATE=false

# ---- 连接池 / 线程 ----
# PSYCH_DB_POOL_MAX=20
# PSYCH_DB_POOL_MIN_IDLE=2
# SERVER_THREADS_MAX=100

# ---- 本机语音转写（Firefox 退路；容器默认留空）----
# 本机 jar 档已默认指向 scripts/asr_transcribe.ps1；要覆盖时取消下一行注释
# PSYCH_ASR_COMMAND=

# ---- 镜像源（Docker Hub 拉不动时用）----
# 国内网络常常连不上 registry-1.docker.io。填一个能用的镜像源，脚本会先经它拉取再打回标准标签；
# 镜像名在编排文件里保持不变。留空则直接用 Docker Hub（或走 Docker Desktop 的代理设置）。
# DOCKER_MIRROR=docker.m.daocloud.io

# ---- 可选：本地模型（仅 stack.sh up --ai 使用）----
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen3-8b
